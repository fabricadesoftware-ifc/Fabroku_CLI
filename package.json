{
  "name": "fabroku",
  "version": "1.0.1",
  "description": "CLI para o Fabroku PaaS — Verificação de deploy, autenticação e gerenciamento de apps.",
  "type": "module",
  "bin": {
    "fabroku": "bin/fabroku.js"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fabricadesoftware-ifc/Fabroku_CLI.git"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "scripts": {
    "build": "node scripts/build-tui.mjs",
    "test": "npm run build && node --test",
    "typecheck": "tsc -p tui/tsconfig.json",
    "prepack": "npm run build",
    "termcn:add": "node scripts/termcn-add.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "README.md"
  ],
  "keywords": [
    "fabroku",
    "deploy",
    "cli",
    "paas",
    "dokku"
  ],
  "author": "fabricadesoftware-ifc",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.3.0",
    "cli-spinners": "^3.4.0",
    "commander": "^12.1.0",
    "ink": "^6.8.0",
    "open": "^10.1.0",
    "react": "^19.2.4",
    "string-width": "^8.2.0",
    "ws": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "esbuild": "^0.25.12",
    "semantic-release": "^25.0.3",
    "typescript": "^5.9.3"
  }
}
